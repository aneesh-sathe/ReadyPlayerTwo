#!/bin/zsh

set -euo pipefail

source "${0:A:h}/lib.zsh"
source "${0:A:h}/smoke-lib.zsh"

[[ "$(uname -s)" == "Darwin" ]] ||
  rpt_die "The packaged lifecycle smoke requires macOS."

rpt_require_command curl "This command is supplied by macOS."
rpt_require_command codesign "This command is supplied by macOS."
rpt_require_command xcodebuild "Install and select Xcode."
rpt_require_command xcodegen "Run brew bundle from the repository root."
rpt_prepare_build_directories

if ! /usr/bin/lockf -s -k -t 0 "$RPT_RUNTIME_ROOT/launcher.lock" true; then
  rpt_die "Stop the active ReadyPlayerTwo launcher before running the smoke check."
fi

umask 077
smoke_directory="$(mktemp -d "$RPT_RUNTIME_ROOT/smoke.XXXXXXXX")"
lifecycle_report="$smoke_directory/lifecycle"
launch_log="$smoke_directory/launch.log"
duplicate_log="$smoke_directory/duplicate.log"
tcc_audit_start="$(date '+%Y-%m-%d %H:%M:%S')"

integer launch_supervisor_pid=0
integer lifecycle_launcher_pid=0
integer lifecycle_broker_pid=0
integer lifecycle_app_pid=0
integer smoke_completed=0

process_is_running() {
  local process_id="$1"
  (( process_id > 0 )) && kill -0 "$process_id" 2>/dev/null
}

wait_for_process_exit() {
  local process_id="$1"
  local process_name="$2"
  local attempt

  for attempt in {1..100}; do
    if ! process_is_running "$process_id"; then
      return
    fi
    sleep 0.1
  done

  rpt_die "$process_name remained alive after supervised teardown."
}

stop_exact_process() {
  local process_id="$1"
  local process_name="$2"

  if ! process_is_running "$process_id"; then
    return
  fi

  kill -TERM "$process_id" 2>/dev/null || true
  local attempt
  for attempt in {1..50}; do
    if ! process_is_running "$process_id"; then
      return
    fi
    sleep 0.1
  done

  rpt_warn "$process_name did not stop during smoke cleanup."
  kill -KILL "$process_id" 2>/dev/null || true
}

cleanup() {
  local exit_status="$?"
  trap - EXIT INT TERM

  if (( ! smoke_completed )); then
    stop_exact_process "$lifecycle_launcher_pid" "captured launcher"
    stop_exact_process "$lifecycle_app_pid" "captured app"
    stop_exact_process "$lifecycle_broker_pid" "captured broker"
    stop_exact_process "$launch_supervisor_pid" "smoke launch supervisor"
  fi

  if (( launch_supervisor_pid > 0 )); then
    wait "$launch_supervisor_pid" 2>/dev/null || true
  fi

  [[ ! -f "$lifecycle_report" ]] || rm -f "$lifecycle_report"
  [[ ! -f "$launch_log" ]] || rm -f "$launch_log"
  [[ ! -f "$duplicate_log" ]] || rm -f "$duplicate_log"
  rmdir "$smoke_directory" 2>/dev/null || true
  exit "$exit_status"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

rpt_note "Starting the real no-key packaged launcher..."
env -u OPENAI_API_KEY \
  "RPT_LIFECYCLE_REPORT_PATH=$lifecycle_report" \
  "$RPT_SCRIPT_DIR/run" \
  >"$launch_log" 2>&1 &
launch_supervisor_pid=$!

for attempt in {1..2400}; do
  if [[ -f "$lifecycle_report" ]]; then
    break
  fi
  if ! process_is_running "$launch_supervisor_pid"; then
    set +e
    wait "$launch_supervisor_pid"
    launcher_status="$?"
    set -e
    launch_supervisor_pid=0
    rpt_die "The no-key launcher exited before the packaged app became ready (status $launcher_status)."
  fi
  sleep 0.25
done
[[ -f "$lifecycle_report" ]] ||
  rpt_die "The packaged app did not become ready within ten minutes."

rpt_smoke_read_lifecycle_report "$lifecycle_report"
lifecycle_launcher_pid="$RPT_SMOKE_LAUNCHER_PID"
lifecycle_broker_pid="$RPT_SMOKE_BROKER_PID"
lifecycle_app_pid="$RPT_SMOKE_APP_PID"

sleep 1
process_is_running "$lifecycle_launcher_pid" ||
  rpt_die "The supervised launcher is not running."
process_is_running "$lifecycle_broker_pid" ||
  rpt_die "The loopback credential broker is not running."
process_is_running "$lifecycle_app_pid" ||
  rpt_die "The packaged app is not running."

grep -Fqx \
  "warning: OPENAI_API_KEY is absent. Voice will report Voice Not Configured." \
  "$launch_log" ||
  rpt_die "The launcher did not confirm the no-key voice path."

app_command="$(
  ps -p "$lifecycle_app_pid" -o command= |
    sed -e 's/^[[:space:]]*//'
)"
[[ "$app_command" == */Contents/MacOS/* ]] ||
  rpt_die "The captured app PID does not identify a packaged executable."
app_bundle="${app_command%/Contents/MacOS/*}"
rpt_smoke_verify_dockless_bundle "$app_bundle"
codesign --verify --deep --strict "$app_bundle" >/dev/null 2>&1 ||
  rpt_die "The packaged app signature is invalid."
rpt_note "ok: packaged app launched as one signed Dockless agent"

node24_binary="$(rpt_node24_binary)"
expected_broker_command="$node24_binary $RPT_SCRIPT_DIR/broker-runner.mjs"
broker_command="$(
  ps -p "$lifecycle_broker_pid" -o command= |
    sed -e 's/^[[:space:]]*//'
)"
[[ "$broker_command" == "$expected_broker_command" ]] ||
  rpt_die "The captured broker PID does not identify the expected broker."

broker_port="$(
  /usr/sbin/lsof \
    -nP \
    -a \
    -p "$lifecycle_broker_pid" \
    -iTCP \
    -sTCP:LISTEN \
    -F n |
    rpt_smoke_parse_loopback_listener
)"
curl \
  -fsS \
  --max-time 3 \
  -o /dev/null \
  "http://127.0.0.1:$broker_port/health" ||
  rpt_die "The loopback credential broker health check failed."
rpt_note "ok: credential broker is healthy and loopback-only"

set +e
env -u OPENAI_API_KEY \
  -u RPT_LIFECYCLE_REPORT_PATH \
  "$RPT_SCRIPT_DIR/run" \
  >"$duplicate_log" 2>&1
duplicate_status="$?"
set -e
[[ "$duplicate_status" == "0" ]] ||
  rpt_die "The duplicate launcher did not exit cleanly."
grep -Fqx "ReadyPlayerTwo is already running." "$duplicate_log" ||
  rpt_die "The duplicate launcher did not report the active runtime."
process_is_running "$lifecycle_launcher_pid" ||
  rpt_die "The original launcher stopped after a duplicate attempt."
process_is_running "$lifecycle_broker_pid" ||
  rpt_die "The original broker stopped after a duplicate attempt."
process_is_running "$lifecycle_app_pid" ||
  rpt_die "The original app stopped after a duplicate attempt."
rpt_note "ok: duplicate launch was rejected without disturbing the runtime"

microphone_request_count="$(
  /usr/bin/log show \
    --start "$tcc_audit_start" \
    --style ndjson \
    --predicate 'subsystem == "com.apple.TCC"' \
    2>/dev/null |
    rpt_smoke_count_microphone_requests \
      "com.aneeshsathe.readyplayertwo" \
      "$lifecycle_app_pid"
)"
[[ "$microphone_request_count" == "0" ]] ||
  rpt_die "The app requested microphone access without a Summon."
rpt_note "ok: launch produced no microphone access request"

rpt_note "Interrupting the captured launcher..."
kill -INT "$lifecycle_launcher_pid"
set +e
wait "$launch_supervisor_pid"
launcher_status="$?"
set -e
launch_supervisor_pid=0
[[ "$launcher_status" == "130" ]] ||
  rpt_die "The interrupted launcher exited with status $launcher_status instead of 130."

wait_for_process_exit "$lifecycle_launcher_pid" "The captured launcher"
wait_for_process_exit "$lifecycle_app_pid" "The captured app"
wait_for_process_exit "$lifecycle_broker_pid" "The captured broker"
rpt_note "ok: terminal interrupt left no captured child process alive"

smoke_completed=1
rpt_note "Packaged lifecycle smoke passed."
