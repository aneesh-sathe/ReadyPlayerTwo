#!/bin/zsh

set -euo pipefail

source "${0:A:h:h}/lib.zsh"

test_directory="$(mktemp -d "${TMPDIR:-/tmp}/readyplayertwo-lifecycle-tests.XXXXXXXX")"
trap 'rm -rf "$test_directory"' EXIT

report_path="$test_directory/lifecycle"
rpt_write_lifecycle_report "$report_path" 101 202 303

expected_report=$'schema_version=1\nlauncher_pid=101\nbroker_pid=202\napp_pid=303'
actual_report="$(<"$report_path")"
[[ "$actual_report" == "$expected_report" ]] ||
  rpt_die "The lifecycle report did not contain only the expected PID fields."

report_mode="$(stat -f '%Lp' "$report_path")"
[[ "$report_mode" == "600" ]] ||
  rpt_die "The lifecycle report must be readable only by its owner."

if rpt_write_lifecycle_report "$report_path" 404 505 606 2>/dev/null; then
  rpt_die "An existing lifecycle report must never be overwritten."
fi

if rpt_write_lifecycle_report "relative-report" 404 505 606 2>/dev/null; then
  rpt_die "A relative lifecycle report path must be rejected."
fi

if rpt_write_lifecycle_report "$test_directory/invalid" 0 505 606 2>/dev/null; then
  rpt_die "Invalid process identifiers must be rejected."
fi

rpt_note "Lifecycle report tests passed."
