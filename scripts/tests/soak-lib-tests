#!/bin/zsh

set -euo pipefail

source "${0:A:h:h}/lib.zsh"
source "${0:A:h:h}/soak-lib.zsh"

integer sampled_process_pid=0
integer second_process_pid=0
integer unexpected_process_pid=0

cleanup() {
  local process_id
  for process_id in \
    "$sampled_process_pid" \
    "$second_process_pid" \
    "$unexpected_process_pid"; do
    if (( process_id > 0 )) && kill -0 "$process_id" 2>/dev/null; then
      kill -TERM "$process_id" 2>/dev/null || true
      wait "$process_id" 2>/dev/null || true
    fi
  done
}

trap cleanup EXIT

unset RPT_SOAK_DURATION_SECONDS
default_duration="$(rpt_soak_duration_seconds)"
[[ "$default_duration" == "7200" ]] ||
  rpt_die "The soak duration must default to two hours."

RPT_SOAK_DURATION_SECONDS=15
short_duration="$(rpt_soak_duration_seconds)"
[[ "$short_duration" == "15" ]] ||
  rpt_die "A short validated soak duration must be available for evaluation."

RPT_SOAK_DURATION_SECONDS=0
if rpt_soak_duration_seconds >/dev/null 2>&1; then
  rpt_die "A non-positive soak duration must be rejected."
fi

unset RPT_SOAK_EXPECTED_PRESENCE
default_presence="$(rpt_soak_expected_presence)"
[[ "$default_presence" == "roam" ]] ||
  rpt_die "The soak must default to ordinary Roaming Presence."

RPT_SOAK_EXPECTED_PRESENCE=park
park_presence="$(rpt_soak_expected_presence)"
[[ "$park_presence" == "park" ]] ||
  rpt_die "The soak must accept an explicit manual Park expectation."

RPT_SOAK_EXPECTED_PRESENCE=unknown
if rpt_soak_expected_presence >/dev/null 2>&1; then
  rpt_die "An unknown expected presence must be rejected."
fi

/bin/sleep 30 &
sampled_process_pid=$!
process_sample="$(rpt_soak_sample_process "$sampled_process_pid")"
sample_fields=("${(@s: :)process_sample}")
[[ "${#sample_fields}" == "4" ]] ||
  rpt_die "A process sample must contain PID, parent PID, CPU, and RSS."
[[ "$sample_fields[1]" == "$sampled_process_pid" ]] ||
  rpt_die "A process sample must identify the exact requested PID."
[[ "$sample_fields[2]" == <1-> ]] ||
  rpt_die "A process sample must contain a positive parent PID."
[[ "$sample_fields[3]" == <0->(|.<0->) ]] ||
  rpt_die "A process sample must contain a non-negative CPU percentage."
[[ "$sample_fields[4]" == <1-> ]] ||
  rpt_die "A process sample must contain positive RSS in KiB."

/bin/sleep 30 &
second_process_pid=$!
rpt_soak_verify_lineage \
  "$$" \
  "$sampled_process_pid" \
  "$second_process_pid"

/bin/sleep 30 &
unexpected_process_pid=$!
unexpected_children="$(
  rpt_soak_unexpected_children \
    "$$" \
    "$sampled_process_pid" \
    "$second_process_pid"
)"
[[ "$unexpected_children" == "$unexpected_process_pid" ]] ||
  rpt_die "The soak must report only unexpected direct children."

persistent_children="$(
  rpt_soak_persistent_unexpected_children \
    $'101\n202' \
    $'202\n303'
)"
[[ "$persistent_children" == "202" ]] ||
  rpt_die "Only a child that survives consecutive samples may fail the soak."

rpt_soak_rss_growth_is_unbounded \
  100000 \
  104096 \
  108192 \
  112288 \
  116384 \
  120480 \
  124576 \
  128672 \
  132768 \
  136864 \
  140960 \
  145056 ||
  rpt_die "Large sustained RSS growth must fail the soak."

if rpt_soak_rss_growth_is_unbounded \
  100000 \
  145000 \
  145000 \
  145000 \
  145000 \
  145000 \
  145000 \
  145000 \
  145000 \
  145000 \
  145000 \
  145000; then
  rpt_die "A bounded one-time RSS allocation must not fail the soak."
fi

rpt_note "Soak library tests passed."
